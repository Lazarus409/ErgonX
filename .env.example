# Local Docker Compose values. Copy this file to `.env`; never commit `.env`.
POSTGRES_DB=ergonx_db
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-pgadmin-password
