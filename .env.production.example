# Copy to .env.production and replace every placeholder. Never commit it.
POSTGRES_DB=ergonx_db
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=replace-with-a-strong-production-password
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
EMAIL_DELIVERY_ENABLED=false
# Gmail / Google Workspace SMTP. Use an App Password, never a mailbox password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-sending-account@example.com
EMAIL_HOST_PASSWORD=replace-with-your-google-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=ErgonX <your-sending-account@example.com>
FRONTEND_PUBLIC_URL=https://app.example.com
